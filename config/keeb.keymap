#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define default_layer 0
#define upper_layer 1
#define game_mode_default_layer 2

/ {
        keymap {
                compatible = "zmk,keymap";
                default_layer {
                        bindings = <
    &kp ESC        &kp N1     &kp N2        &kp N3     &kp N4     &kp N5     &kp C_VOL_UP
    &kp TAB        &kp Q      &kp W         &kp F      &kp P      &kp G      &kp C_MUTE
    &kp LCTRL      &kp A      &kp R         &kp S      &kp T      &kp D      &kp C_BRI_UP
    &mo 1          &kp Z      &kp X         &kp C      &kp V      &kp B      &none
                              &kp LALT      &kp LGUI   &kp RET    &kp SPACE  &kp LSHFT

    &kp LG(L)      &kp N6     &kp N7        &kp N8     &kp N9     &kp N0     &kp MINUS
    &kp LG(LS(S))  &kp J      &kp L         &kp U      &kp Y      &kp SEMI   &kp EQUAL
    &kp C_NEXT     &kp H      &kp N         &kp E      &kp I      &kp O      &kp SQT
    &bt BT_NXT     &kp K      &kp M         &kp COMMA  &kp DOT    &kp FSLH   &kp BSLH
    &kp RSHFT      &kp SPACE  &kp BSPC      &kp LBKT   &kp RBKT
                        >;
                };
                upper_layer {
                        bindings = <
    &none          &kp GRAVE  &none         &none      &kp F1     &kp F5     &kp C_VOL_DN
    &kp CAPS       &kp LEFT   &kp UP        &none      &kp F2     &kp F6     &kp C_PP
    &none          &none      &kp DOWN      &kp RIGHT  &kp F3     &kp F7     &kp C_BRI_DN
    &none          &none      &none         &none      &kp F4     &kp F8     &tog 2
                              &kp LALT      &kp LGUI   &kp RET    &kp SPACE  &kp LSHFT

    &none          &kp F9     &none         &none      &none      &kp F13    &kp DEL
    &none          &kp F10    &kp KP_N7     &kp KP_N8  &kp KP_N9  &kp F14    &kp PAUSE_BREAK
    &kp C_PREV     &kp F11    &kp KP_N4     &kp KP_N5  &kp KP_N6  &kp F15    &kp PSCRN
    &bt BT_CLR     &kp F12    &kp KP_N1     &kp KP_N2  &kp KP_N3  &kp F16    &none
    &none          &none      &kp KP_ENTER  &kp KP_N0  &kp KP_DOT
                        >;
                };
                game_mode_default_layer {
                        bindings = <
    &kp ESC        &kp N1     &kp N2        &kp N3     &kp N4     &kp N5     &kp C_VOL_UP
    &kp ESC        &kp TAB    &kp Q         &kp N1     &kp E      &kp R      &kp C_MUTE
    &kp TAB        &kp LSHFT  &kp A         &kp W      &kp D      &kp F      &kp C_BRI_UP
    &mo 1          &kp LCTRL  &kp Z         &kp S      &kp C      &kp V      &tog 0
                              &kp LALT      &kp LGUI   &kp RET    &kp SPACE  &kp LSHFT

    &kp LG(L)      &kp N6     &kp N7        &kp N8     &kp N9     &kp N0     &kp MINUS
    &kp LG(LS(S))  &kp J      &kp L         &kp U      &kp Y      &kp SEMI   &kp EQUAL
    &kp C_NEXT     &kp H      &kp N         &kp E      &kp I      &kp O      &kp SQT
    &bt BT_NXT     &kp K      &kp M         &kp COMMA  &kp DOT    &kp FSLH   &kp BSLH
    &kp RSHFT      &kp SPACE  &kp BSPC      &kp LBKT   &kp RBKT
                        >;
                };
        };
};

